<%- include('partials/header') %>

<% if (showLogin) { %>

  <div class="page-header">
    <h1>Admin Portal Login</h1>
    <p class="page-subtitle">Enter your administrative password to access system reports.</p>
  </div>

  <% if (error) { %>
    <div class="error-message">
      <span class="icon">⚠️</span> <%= error %>
    </div>
  <% } %>

  <form action="/admin/login" method="POST" class="form-box">
    <div class="form-group">
      <label for="password">Admin Password</label>
      <input type="password" id="password" name="password" placeholder="••••••••" required autofocus>
    </div>

    <button type="submit" class="btn btn-primary">Authenticate</button>
  </form>

<% } else { %>

  <div class="admin-dashboard-header">
    <div>
      <h1>All Submitted Complaints</h1>
      <p class="page-subtitle">Total records: <span class="badge badge-count"><%= complaints.length %></span></p>
    </div>
    <a href="/admin/logout" class="btn btn-outline-danger">Logout Admin</a>
  </div>

  <% if (complaints.length === 0) { %>
    <div class="empty-state">
      <p>No complaints have been submitted yet.</p>
    </div>
  <% } else { %>
    
    <div class="table-responsive">
      <table class="complaint-table">
        <thead>
          <tr>
            <th>User Name</th>
            <th>Email Address</th>
            <th>Subject</th>
            <th>Description</th>
            <th>Date & Time</th>
          </tr>
        </thead>
        <tbody>
          <% complaints.forEach(function(complaint) { %>
            <tr>
              <td class="font-weight-bold"><%= complaint.userName %></td>
              <td><a href="mailto:<%= complaint.userEmail %>" class="table-link"><%= complaint.userEmail %></a></td>
              <td><span class="subject-tag"><%= complaint.subject %></span></td>
              <td class="description-cell"><%= complaint.description %></td>
              <td class="date-cell"><%= complaint.createdAt.toLocaleString() %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>

<% } %>

<%- include('partials/footer') %>